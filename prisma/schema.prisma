generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Employee {
  id            String         @id @default(uuid())
  name          String         @unique
  shifts        PayrollShift[]
  createdAt     DateTime       @default(now())
}

model PayrollShift {
  id            String   @id @default(uuid())
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  clockIn       DateTime
  clockOut      DateTime
  totalHours    Float
  createdAt     DateTime @default(now())

  @@index([employeeId, clockIn])
}
